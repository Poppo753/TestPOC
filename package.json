  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit/**/*.test.ts",
    "test:integration": "hardhat test test/integration/**/*.test.ts",
    "test:security": "hardhat test test/security/*.test.ts",
    "test:invariants": "hardhat test test/invariants/*.test.ts",
    "test:fork": "cross-env FORK_ENABLED=true hardhat test test/e2e/**/*.test.ts",
    "test:metavault": "hardhat test test/unit/metavault/InterVault.bundle.test.ts test/integration/metavault/InterVault.Core.integration.test.ts test/e2e/InterVault.AutomaticWithdrawal.local.e2e.test.ts",
    "test:metavault:fork": "hardhat test test/integration/metavault/InterVault.POCLeaf.fork.test.ts",
    "test:coverage": "hardhat coverage",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File ./test-e2e.ps1",
    "test:gmx": "FORK_ENABLED=true hardhat test test/integration/GMXv2Plugin.e2e.test.ts --network hardhat",
    "compile": "hardhat compile",
    "scripts:typecheck": "tsc -p tsconfig.scripts.json",
    "scripts:test": "hardhat test test/scripts/Framework.test.ts test/scripts/Operations.test.ts test/scripts/Deployment.test.ts test/integration/scripts/Phase1.Core.test.ts",
    "scripts:cli": "ts-node scripts/cli.ts",
    "automation:cli": "ts-node scripts/automation/cli.ts",
    "automation:test": "hardhat test test/automation/VaultAutomationController.test.ts test/automation/InterVaultAutomation.test.ts",
    "verify:poc": "hardhat run scripts/verification/verify-poc.ts --network arbitrum",
    "deploy:setup": "hardhat run scripts/deploy/setupGMXv2Plugin.ts --network arbitrum",
    "deploy:testnet": "hardhat run scripts/deploy/setupGMXv2Plugin.ts --network arbitrumSepolia",
    "test:flow": "hardhat run scripts/test/testGMXv2Flow.ts --network arbitrum"
  },
