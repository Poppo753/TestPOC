{
  "name": "my-defi-strategy",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit/**/*.test.ts",
    "test:integration": "hardhat test test/integration/**/*.test.ts",
    "test:security": "hardhat test test/security/*.test.ts",
    "test:invariants": "hardhat test test/invariants/*.test.ts",
    "test:fork": "cross-env FORK_ENABLED=true hardhat test test/e2e/**/*.test.ts",
    "test:coverage": "hardhat coverage",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File ./test-e2e.ps1",
    "test:gmx": "FORK_ENABLED=true hardhat test test/integration/GMXv2Plugin.e2e.test.ts --network hardhat",
    "compile": "hardhat compile",
    "deploy:setup": "hardhat run scripts/deploy/setupGMXv2Plugin.ts --network arbitrum",
    "deploy:testnet": "hardhat run scripts/deploy/setupGMXv2Plugin.ts --network arbitrumSepolia",
    "test:flow": "hardhat run scripts/test/testGMXv2Flow.ts --network arbitrum"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.1",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "chai": "^4.3.10",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "hardhat": "^2.19.3",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^4.9.2",
    "@uniswap/v3-periphery": "^1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
