---
type IconName = 'wallet' | 'vault' | 'send' | 'ledger';

interface Props {
  name: IconName;
  label?: string;
  class?: string;
}

const paths: Record<IconName, string[]> = {
  wallet: [
    'M3 7.5h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3v-10a2.5 2.5 0 0 1 2.5-2.5H18',
    'M16 12h5v4h-5a2 2 0 1 1 0-4Z',
  ],
  vault: ['M4 8h16v12H4z', 'M7 8V5h10v3M8 12h8M8 16h5'],
  send: ['M4 12 20 4l-6 16-3-7-7-1Z', 'm11 1 5-5'],
  ledger: ['M5 3h14v18H5z', 'M8 8h8M8 12h8M8 16h5'],
};

const { name, label, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {paths[name].map((path) => <path d={path} />)}
</svg>
