---
import Eyebrow from '../primitives/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'start' | 'center';
  class?: string;
  id?: string;
}

const { eyebrow, title, description, align = 'start', class: className, id } = Astro.props;
---

<header
  class:list={['section-heading', align === 'center' && 'section-heading--center', className]}
>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 {id}>{title}</h2>
  {description && <p class="lede">{description}</p>}
  <slot />
</header>
