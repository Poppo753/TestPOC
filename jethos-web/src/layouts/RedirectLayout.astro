---
interface Props {
  title: string;
  target: string;
  message: string;
  linkLabel: string;
}

const { title, target, message, linkLabel } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>{title}</title>
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>{message} <a href={target}>{linkLabel}</a>.</p>
  </body>
</html>
