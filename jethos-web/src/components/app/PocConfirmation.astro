<div class="modal-backdrop" data-confirm-backdrop hidden>
  <section class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <h2 id="confirm-title">Confirm action</h2>
    <p id="confirm-description"></p>
    <div class="callout callout--warning">
      <strong>Verify in your wallet.</strong> Check chain, token, amount and contract address before signing.
    </div>
    <div class="cluster" style="justify-content:flex-end;margin-top:1rem">
      <button class="button button--ghost" id="confirm-cancel" type="button">Cancel</button>
      <button class="button button--primary" id="confirm-action" type="button">Continue</button>
    </div>
  </section>
</div>
<div class="toast-region" aria-live="polite" aria-atomic="true" data-app-toasts></div>
