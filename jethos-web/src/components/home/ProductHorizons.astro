<section class="product-horizons" aria-label="Jethos product horizons">
  <div class="container horizon-strip">
    <button
      type="button"
      class="horizon-item horizon-item--current"
      data-horizon-step="poc"
      aria-expanded="false"
      ><span class="horizon-node"><b>01</b><small>Now</small></span><span class="horizon-copy"
        ><strong>Private USDC PoC</strong><small>Validate one focused vault</small></span
      ></button
    >
    <span class="horizon-link" aria-hidden="true"><i></i></span>
    <button type="button" class="horizon-item" data-horizon-step="multi-asset" aria-expanded="false"
      ><span class="horizon-node"><b>02</b><small>Next</small></span><span class="horizon-copy"
        ><strong>Multi-asset vaults</strong><small>Add authorized assets</small></span
      ></button
    >
    <span class="horizon-link" aria-hidden="true"><i></i></span>
    <button type="button" class="horizon-item" data-horizon-step="multi-chain" aria-expanded="false"
      ><span class="horizon-node"><b>03</b><small>Expand</small></span><span class="horizon-copy"
        ><strong>Multi-chain vaults</strong><small>Open validated networks</small></span
      ></button
    >
    <span class="horizon-link" aria-hidden="true"><i></i></span>
    <button type="button" class="horizon-item" data-horizon-step="consumer" aria-expanded="false"
      ><span class="horizon-node"><b>04</b><small>Product</small></span><span class="horizon-copy"
        ><strong>Consumer app</strong><small>Make the experience effortless</small></span
      ></button
    >
    <span class="horizon-link" aria-hidden="true"><i></i></span>
    <button
      type="button"
      class="horizon-item horizon-item--vision"
      data-horizon-step="vision"
      aria-expanded="false"
      ><span class="horizon-node"><b>05</b><small>Vision</small></span><span class="horizon-copy"
        ><strong>Complete financial home</strong><small>Hold, invest, understand and use</small
        ></span
      ></button
    >
  </div>
  <aside
    class="horizon-popover"
    data-horizon-popover
    hidden
    aria-live="polite"
    aria-labelledby="horizon-popover-title"
  >
    <span class="eyebrow" data-horizon-popover-label>Phase 01 · Now</span>
    <strong id="horizon-popover-title" data-horizon-popover-title>Private USDC PoC</strong>
    <p data-horizon-popover-description></p>
    <small data-horizon-popover-gate></small>
  </aside>
</section>
