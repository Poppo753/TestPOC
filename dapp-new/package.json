{
  "name": "jethos-web",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validation/validate-site.mjs",
    "check:content": "node scripts/validation/check-content.mjs",
    "check:product": "node scripts/validation/validate-product-content.mjs",
    "check:demo": "node scripts/validation/validate-demo.mjs && node scripts/validation/test-demo-engine.mjs",
    "check:demo:browser": "node scripts/browser/demo-smoke.mjs",
    "check:auth:browser": "node scripts/browser/auth-smoke.mjs",
    "check:webgl": "node scripts/validation/validate-webgl.mjs",
    "check:webgl:browser": "node scripts/browser/webgl-smoke.mjs",
    "capture:webgl": "node scripts/browser/capture-webgl-review.mjs",
    "sync:docs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/documentation/sync-documentation.ps1",
    "check:docs": "node scripts/validation/validate-documentation.mjs",
    "check:docs:browser": "node scripts/browser/documentation-smoke.mjs",
    "check:deployment": "node scripts/diagnostics/check-deployment.mjs",
    "inspect:protocols": "node scripts/diagnostics/inspect-protocols.mjs",
    "ready": "node scripts/release-readiness.mjs"
  }
}
