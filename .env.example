# ============================================
# ARBITRUM RPC ENDPOINTS
# ============================================

# Arbitrum Mainnet RPC (required for mainnet deployment)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Alternative: https://arbitrum.llamarpc.com

# Arbitrum Sepolia Testnet RPC (for testing before mainnet)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ============================================
# WALLET CONFIGURATION
# ============================================

# Private key of deployer wallet (NEVER COMMIT THIS!)
# Must have ETH for gas:
#   - Mainnet: ~0.01-0.02 ETH recommended
#   - Testnet: Get free ETH from faucet https://faucet.quicknode.com/arbitrum/sepolia
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ============================================
# BLOCK EXPLORER (ARBISCAN)
# ============================================

# Arbiscan API key for contract verification (FREE)
# Get yours at: https://arbiscan.io/myapikey
ARBITRUM_ETHERSCAN_API_KEY=your_arbiscan_api_key_here

# ============================================
# EXISTING DEPLOYED CONTRACTS (MAINNET)
# ============================================

# Beacon contract (your existing Beacon address)
# If you don't have one deployed yet, deploy it first
BEACON_ADDRESS=your_beacon_address_here

# SimpleSwap deployed (Uniswap V3 wrapper)
# Mainnet: 0xa0DB78167CBAccD47524a261b7741C6B41Bbd096
# Testnet: Deploy MockSimpleSwap first or deploy your own
SIMPLE_SWAP_ADDRESS=0xa0DB78167CBAccD47524a261b7741C6B41Bbd096

# ============================================
# NEW CONTRACTS (filled by deployment scripts)
# ============================================

# UniswapV3Plugin (filled by script 00_deploy_uniswapv3plugin.ts)
UNISWAPV3_PLUGIN_ADDRESS=

# New SwapManager (filled by script 02_deploy_new_swapmanager.ts)
NEW_SWAP_MANAGER_ADDRESS=

# Old SwapManager (your current SwapManager, if any)
OLD_SWAP_MANAGER_ADDRESS=

# ============================================
# HARDHAT FORK MODE (OPTIONAL - for testing)
# ============================================

# Enable fork mode to test against Arbitrum mainnet state
FORK_ENABLED=false

# Fork from specific block (optional, uses latest if not set)
# FORK_BLOCK_NUMBER=12345678

# ============================================
# GAS REPORTER (OPTIONAL)
# ============================================

# Enable gas reporting in tests
REPORT_GAS=false

# CoinMarketCap API key for USD gas estimates (optional)
# Get free key at: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================
# 
# BEFORE DEPLOYMENT:
# ☐ 1. Set PRIVATE_KEY (wallet with ETH for gas)
# ☐ 2. Set ARBITRUM_RPC_URL (mainnet) or ARBITRUM_SEPOLIA_RPC_URL (testnet)
# ☐ 3. Set BEACON_ADDRESS (your existing Beacon)
# ☐ 4. Set SIMPLE_SWAP_ADDRESS (0xa0DB7... for mainnet)
# ☐ 5. Set ARBITRUM_ETHERSCAN_API_KEY (for verification)
# ☐ 6. Verify wallet has sufficient ETH (~0.02 ETH recommended)
# 
# DEPLOYMENT SEQUENCE:
# 1. npx hardhat run scripts/migration/00_deploy_uniswapv3plugin.ts --network arbitrum
# 2. npx hardhat run scripts/migration/01_register_simpleswap.ts --network arbitrum
# 3. npx hardhat run scripts/migration/02_deploy_new_swapmanager.ts --network arbitrum
# 4. npx hardhat run scripts/migration/03_update_beacon.ts --network arbitrum
# 5. npx hardhat run scripts/migration/04_verify_system.ts --network arbitrum
# 6. npx hardhat run scripts/migration/05_verify_contracts.ts --network arbitrum
# 
# TESTNET TESTING (recommended before mainnet):
# Replace --network arbitrum with --network arbitrumSepolia
# 
# ============================================

# ============================================
# SECURITY WARNINGS
# ============================================
# 
# ⚠️  NEVER commit .env file to git!
# ⚠️  NEVER share your PRIVATE_KEY!
# ⚠️  Use a separate wallet for deployment (not your main wallet)
# ⚠️  Test on Arbitrum Sepolia testnet first!
# ⚠️  Keep backups of all addresses after deployment
# 
# ============================================
